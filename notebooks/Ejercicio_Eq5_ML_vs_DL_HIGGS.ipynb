    "def exp_mejorar_red():\n",
    "    n = 300_000\n",
    "    if n > len(X_pool): n = len(X_pool)\n",
    "    Xn, yn = X_pool[:n], y_pool[:n]\n",
    "    logger.info(f'\\n========== MEJORANDO LA RED (TAMAÑO: {n}) ==========')\n",
    "\n",
    "    configuraciones = [\n",
    "        {\"nombre\": \"Red Base (Clase)\", \"capas\": (256, 256, 256), \"lr\": 1e-3, \"dropout\": False},\n",
    "        {\"nombre\": \"Red Menor LR\", \"capas\": (256, 256, 256), \"lr\": 1e-4, \"dropout\": False},\n",
    "        {\"nombre\": \"Red Ancha + Dropout\", \"capas\": (512, 512), \"lr\": 1e-3, \"dropout\": True},\n",
    "        {\"nombre\": \"Red Profunda\", \"capas\": (128, 128, 128, 128, 128), \"lr\": 1e-3, \"dropout\": False}\n",
    "    ]\n",
    "\n",
    "    for conf in configuraciones:\n",
    "        t0 = time.time()\n",
    "        # Usamos la función modificada que acepta lr y use_dropout\n",
    "        red, _ = entrenar_red(Xn, yn, capas=conf[\"capas\"], lr=conf[\"lr\"], use_dropout=conf[\"dropout\"], semilla=42)\n",
    "        acc_test = accuracy_score(y_test, prob_red(red, X_test) > 0.5)\n",
    "        logger.info(f\"Config: {conf['nombre']:>25} | Tiempo: {time.time()-t0:.1f}s | Exactitud Test: {acc_test*100:.2f}%\")\n",
    "\n",
    "exp_mejorar_red()"
