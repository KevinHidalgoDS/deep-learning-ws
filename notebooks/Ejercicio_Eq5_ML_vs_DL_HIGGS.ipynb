    "def fijar_semilla(seed):\n",
    "    \"\"\"Fija las semillas de todos los generadores aleatorios para reproducibilidad.\n",
    "\n",
    "    Configura las semillas de Python (`random`), NumPy y PyTorch (CPU y, si está\n",
    "    disponible, CUDA) para garantizar que los resultados sean deterministas\n",
    "    entre ejecuciones.\n",
    "\n",
    "    Args:\n",
    "        seed (int): Valor entero utilizado como semilla para todos los\n",
    "            generadores pseudoaleatorios.\n",
    "\n",
    "    Returns:\n",
    "        None: Esta función no devuelve ningún valor; su efecto es la\n",
    "        modificación del estado global de los generadores aleatorios.\n",
    "\n",
    "    Ejemplo:\n",
    "        >>> fijar_semilla(42)\n",
    "        >>> # A partir de aquí, todos los aleatorios son reproducibles.\n",
    "    \"\"\"\n",
    "    # --- Bloque 1: Registro de la acción de fijado de semilla ---\n",
    "    logger.debug(f'Fijando semilla a: {seed}')\n",
    "\n",
    "    # --- Bloque 2: Fijado de semillas en Python, NumPy y PyTorch (CPU) ---\n",
    "    torch.manual_seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    random.seed(seed)\n",
    "\n",
    "    # --- Bloque 3: Fijado de semillas en GPU (si está disponible) ---\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.manual_seed_all(seed)\n",
    "        logger.debug('Semillas de CUDA fijadas correctamente.')\n",
    "\n",
    "def entrenar_red(\n",
    "    X,\n",
    "    y,\n",
    "    capas=(256, 256, 256),\n",
    "    semilla=SEMILLA,\n",
    "    dispositivo=None,\n",
    "    max_epocas=None,\n",
    "    paciencia=15,\n",
    "    lr=1e-3,\n",
    "    use_dropout=False,\n",
    "):\n",
    "    \"\"\"Entrena una red neuronal dinámica con early stopping y validación interna.\n",
    "\n",
    "    Construye una red `Sequential` a partir de la tupla `capas`, divide los\n",
    "    datos en un conjunto de validación (mínimo 200 muestras o el 10 % de `X`)\n",
    "    y el resto para entrenamiento. Entrena con `AdamW` + `BCEWithLogitsLoss`\n",
    "    usando mini-lotes cuyo tamaño se adapta al volumen de datos. Aplica\n",
    "    *early stopping* según la pérdida de validación y restaura los mejores\n",
    "    pesos encontrados.\n",
    "\n",
    "    Args:\n",
    "        X (np.ndarray): Matriz de características con forma `(n, d)`.\n",
    "        y (np.ndarray): Vector de etiquetas binarias con forma `(n,)`.\n",
    "        capas (tuple of int, optional): Anchos de las capas ocultas en orden.\n",
    "            Por defecto `(256, 256, 256)`.\n",
    "        semilla (int, optional): Semilla para inicialización de pesos y\n",
    "            particionado. Por defecto `SEMILLA_BASE`.\n",
    "        dispositivo (torch.device, optional): Dispositivo de cómputo. Si es\n",
    "            `None`, se usa el `DISPOSITIVO` global. Por defecto `None`.\n",
    "        max_epocas (int, optional): Número máximo de épocas. Si es `None`, se\n",
    "            calcula dinámicamente según el tamaño del dataset. Por defecto `None`.\n",
    "        paciencia (int, optional): Épocas consecutivas sin mejora antes de\n",
    "            detener el entrenamiento. Por defecto `15`.\n",
    "        lr (float, optional): Tasa de aprendizaje del optimizador AdamW.\n",
    "            Por defecto `1e-3`.\n",
    "        use_dropout (bool, optional): Si es `True`, inserta `Dropout(0.3)`\n",
    "            tras cada capa ReLU. Por defecto `False`.\n",
    "\n",
    "    Returns:\n",
    "        tuple: Una tupla `(modelo, metricas)` donde:\n",
    "            - `modelo` (nn.Sequential): Modelo entrenado en modo `eval()`\n",
    "              con los mejores pesos restaurados.\n",
    "            - `metricas` (dict): Diccionario con las claves:\n",
    "                - `\"epocas\"` (int): Número total de épocas ejecutadas.\n",
    "                - `\"tiempo\"` (float): Tiempo total de entrenamiento en segundos.\n",
    "\n",
    "    Raises:\n",
    "        Exception: Propaga excepciones no controladas del bucle de\n",
    "            entrenamiento (p. ej., errores de memoria en GPU), tras\n",
    "            registrarlas con `logger.exception`.\n",
    "\n",
    "    Ejemplo:\n",
    "        >>> modelo, metricas = entrenar_red(X, y, capas=(128, 64), lr=5e-4)\n",
    "        >>> print(metricas[\"epocas\"], metricas[\"tiempo\"])\n",
    "    \"\"\"\n",
    "    # --- Bloque 1: Resolución del dispositivo y registro de configuración ---\n",
    "    dispositivo = dispositivo or DISPOSITIVO\n",
    "    n = len(X)\n",
    "    logger.info(\n",
    "        f'Iniciando entrenamiento: n={n}, capas={capas}, lr={lr}, '\n",
    "        f'paciencia={paciencia}, dropout={use_dropout}, dispositivo={dispositivo}'\n",
    "    )\n",
    "    if use_dropout:\n",
    "        logger.debug('Dropout activado en la arquitectura (p=0.3 por bloque).')\n",
    "\n",
    "    # --- Bloque 2: Particionado train/validación con RNG reproducible ---\n",
    "    orden = np.random.default_rng(1).permutation(n)\n",
    "    n_val = max(200, n // 10)\n",
    "    val, tr = orden[:n_val], orden[n_val:]\n",
    "    logger.debug(f'Particionado: {len(tr)} train / {len(val)} validacion.')\n",
    "\n",
    "    # --- Bloque 3: Conversión de particiones a tensores en el dispositivo ---\n",
    "    a_tensor = lambda a: torch.tensor(a, dtype=torch.float32, device=dispositivo)\n",
    "    Xtr, ytr = a_tensor(X[tr]), a_tensor(y[tr]).unsqueeze(1)\n",
    "    Xva, yva = a_tensor(X[val]), a_tensor(y[val]).unsqueeze(1)\n",
    "\n",
    "    # --- Bloque 4: Fijado de semilla y construcción dinámica del modelo ---\n",
    "    torch.manual_seed(semilla)\n",
    "    bloques, entrada = [], X.shape[1]\n",
    "    for ancho in capas:\n",
    "        bloques += [nn.Linear(entrada, ancho), nn.ReLU()]\n",
    "        if use_dropout:\n",
    "            bloques.append(nn.Dropout(0.3))\n",
    "        entrada = ancho\n",
    "    bloques.append(nn.Linear(entrada, 1))\n",
    "    modelo = nn.Sequential(*bloques).to(dispositivo)\n",
    "    logger.debug(f'Modelo construido con {len(bloques)} bloques.')\n",
    "\n",
    "    # --- Bloque 5: Configuración del optimizador, pérdida y tamaños ---\n",
    "    optimizador = torch.optim.AdamW(modelo.parameters(), lr=lr, weight_decay=1e-4)\n",
    "    perdida_fn = nn.BCEWithLogitsLoss()\n",
    "    lote = 128 if n < 100_000 else 1024\n",
    "    max_epocas = max_epocas or int(np.clip(3e6 / n, 15, 300))\n",
    "    logger.info(f'Configuracion: lote={lote}, max_epocas={max_epocas}')\n",
    "    if n < 200:\n",
    "        logger.warning(\n",
    "            f'Dataset muy pequeno (n={n}). La validacion puede ser poco fiable.'\n",
    "        )\n",
    "\n",
    "    # --- Bloque 6: Bucle de entrenamiento con early stopping ---\n",
    "    mejor, mejores_pesos, sin_mejora, t0 = np.inf, None, 0, time.time()\n",
    "    epoca = -1  # Inicialización defensiva para el bloque except\n",
    "    try:\n",
    "        for epoca in range(max_epocas):\n",
    "            # --- Bloque 6.1: Fase de entrenamiento por mini-lotes ---\n",
    "            modelo.train()\n",
    "            idx = torch.randperm(len(Xtr), device=dispositivo)\n",
    "            for i in range(0, len(Xtr), lote):\n",
    "                b = idx[i:i + lote]\n",
    "                optimizador.zero_grad()\n",
    "                perdida_fn(modelo(Xtr[b]), ytr[b]).backward()\n",
    "                optimizador.step()\n",
    "\n",
    "            # --- Bloque 6.2: Evaluación sobre validación ---\n",
    "            modelo.eval()\n",
    "            with torch.no_grad():\n",
    "                val_loss = perdida_fn(modelo(Xva), yva).item()\n",
    "\n",
    "            # --- Bloque 6.3: Seguimiento del mejor modelo y early stopping ---\n",
    "            if val_loss < mejor:\n",
    "                mejor = val_loss\n",
    "                mejores_pesos = copy.deepcopy(modelo.state_dict())\n",
    "                sin_mejora = 0\n",
    "                logger.debug(\n",
    "                    f'Epoca {epoca + 1}: nueva mejor val_loss={mejor:.4f}'\n",
    "                )\n",
    "            else:\n",
    "                sin_mejora += 1\n",
    "                logger.debug(\n",
    "                    f'Epoca {epoca + 1}: sin mejora ({sin_mejora}/{paciencia}), '\n",
    "                    f'val_loss={val_loss:.4f}'\n",
    "                )\n",
    "                if sin_mejora >= paciencia:\n",
    "                    logger.info(\n",
    "                        f'Early stopping activado en la epoca {epoca + 1} '\n",
    "                        f'tras {paciencia} epocas sin mejora.'\n",
    "                    )\n",
    "                    break\n",
    "\n",
    "    except Exception as e:\n",
    "        # --- Bloque 6.4: Registro de errores durante el entrenamiento ---\n",
    "        logger.error(f'Entrenamiento interrumpido en la epoca {epoca + 1}')\n",
    "        logger.exception(e)\n",
    "        raise\n",
    "\n",
    "    # --- Bloque 7: Restauracion de mejores pesos y modo evaluacion ---\n",
    "    if mejores_pesos is not None:\n",
    "        modelo.load_state_dict(mejores_pesos)\n",
    "        logger.debug('Mejores pesos restaurados en el modelo.')\n",
    "    else:\n",
    "        logger.warning('No se registro ningun peso optimo; se conserva el modelo actual.')\n",
    "    modelo.eval()\n",
    "\n",
    "    # --- Bloque 8: Calculo de metricas finales y retorno ---\n",
    "    metricas = {\"epocas\": epoca + 1, \"tiempo\": time.time() - t0}\n",
    "    logger.info(\n",
    "        f'Entrenamiento finalizado: epocas={metricas[\"epocas\"]}, '\n",
    "        f'tiempo={metricas[\"tiempo\"]:.2f}s, mejor_val_loss={mejor:.4f}'\n",
    "    )\n",
    "    return modelo, metricas\n",
    "\n",
    "\n",
    "def modelos_clasicos(semilla):\n",
    "    return {\n",
    "        \"Regresión logística\": LogisticRegression(max_iter=1000),\n",
    "        \"Random Forest\": RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=semilla),\n",
    "        \"Gradient Boosting\": HistGradientBoostingClassifier(max_iter=500, random_state=semilla),\n",
    "    }\n",
    "\n",
    "\n",
    "def ejecutar_experimento_curva(semilla_actual):\n",
    "    logger.info(f'\\n========== INICIANDO EXPERIMENTO CURVA | SEMILLA: {semilla_actual} ==========')\n",
    "\n",
    "    TAMANOS = [1_000, 3_000, 10_000, 30_000, 100_000, 300_000, 1_000_000, 2_000_000]\n",
    "    if MODO_RAPIDO:\n",
    "        TAMANOS = [1_000, 3_000, 10_000, 30_000, 100_000, 300_000]\n",
    "\n",
    "    RF_MAXIMO = 1_000_000\n",
    "    if os.cpu_count() <= 4:\n",
    "        RF_MAXIMO = 300_000\n",
    "\n",
    "    resultados = []\n",
    "    for n in TAMANOS:\n",
    "        if n > len(X_pool):\n",
    "            logger.warning(f'Saltando tamaño {n} porque el pool simulado es más pequeño.')\n",
    "            continue\n",
    "\n",
    "        Xn, yn = X_pool[:n], y_pool[:n]\n",
    "        m_tr = min(n, 100_000)\n",
    "\n",
    "        for nombre, modelo in modelos_clasicos(semilla_actual).items():\n",
    "            if nombre == \"Random Forest\" and n > RF_MAXIMO:\n",
    "                continue\n",
    "            t0 = time.time()\n",
    "            modelo.fit(Xn, yn)\n",
    "            dur = time.time() - t0\n",
    "            resultados.append({\"n\": n, \"modelo\": nombre, \"tiempo\": dur,\n",
    "                               \"acc_train\": accuracy_score(yn[:m_tr], modelo.predict(Xn[:m_tr])),\n",
    "                               \"acc_test\": accuracy_score(y_test, modelo.predict(X_test))})\n",
    "\n",
    "        red, info = entrenar_red(Xn, yn, semilla=semilla_actual)\n",
    "        resultados.append({\"n\": n, \"modelo\": \"Red neuronal\", \"tiempo\": info[\"tiempo\"],\n",
    "                           \"acc_train\": accuracy_score(yn[:m_tr], prob_red(red, Xn[:m_tr]) > 0.5),\n",
    "                           \"acc_test\": accuracy_score(y_test, prob_red(red, X_test) > 0.5)})\n",
    "\n",
    "        fila = {r[\"modelo\"]: f\"{100 * r['acc_test']:.1f}%\" for r in resultados if r[\"n\"] == n}\n",
    "        print(f\"n = {n:>9,}  |  {fila}\")\n",
    "\n",
    "    # Visualización\n",
    "    res = pd.DataFrame(resultados)\n",
    "    ESTILO = {\"Red neuronal\": (\"o-\", 3), \"Gradient Boosting\": (\"s-\", 2), \"Random Forest\": (\"^-\", 2), \"Regresión logística\": (\"x--\", 1.5)}\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    for modelo, (marca, grosor) in ESTILO.items():\n",
    "        d = res[res.modelo == modelo]\n",
    "        plt.plot(d.n, 100 * d.acc_test, marca, lw=grosor, ms=7, label=modelo)\n",
    "    plt.xscale(\"log\"); plt.grid(alpha=0.3)\n",
    "    plt.xlabel(\"cantidad de datos de entrenamiento (escala logarítmica)\"); plt.ylabel(\"exactitud en prueba (%)\")\n",
    "    plt.title(f\"¿Quién gana según la cantidad de datos? (Semilla: {semilla_actual})\"); plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "    return res.pivot(index=\"n\", columns=\"modelo\", values=\"acc_test\").mul(100).round(1)\n"
   ],
