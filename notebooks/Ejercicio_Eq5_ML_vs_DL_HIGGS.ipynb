      "source": [
        "Y ahora la **misma red**, con los **mismos datos** (300 000 choques), entrenada **una época** en CPU y en GPU:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "3417e259",
      "metadata": {
        "id": "3417e259",
        "outputId": "a2797c93-45cd-4278-d9b9-41c48567c7a2",
        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "CPU (2 núcleos): 3.2 s por época\n",
            "GPU (Tesla T4): 0.48 s por época  →  7 veces más rápida\n"
          ]
        }
      ],
      "source": [
        "def tiempo_una_epoca(dispositivo, n=300_000):\n",
        "    Xt = torch.tensor(X_pool[:n], device=dispositivo); yt = torch.tensor(y_pool[:n], device=dispositivo).unsqueeze(1)\n",
        "    torch.manual_seed(SEMILLA)\n",
        "    m = crear_red().to(dispositivo); opt = torch.optim.AdamW(m.parameters(), lr=1e-3); f = nn.BCEWithLogitsLoss()\n",
        "    if dispositivo == \"cuda\": torch.cuda.synchronize()\n",
        "    t = time.time()\n",
        "    for i in range(0, n, 1024):\n",
        "        opt.zero_grad(); f(m(Xt[i:i + 1024]), yt[i:i + 1024]).backward(); opt.step()\n",
        "    if dispositivo == \"cuda\": torch.cuda.synchronize()\n",
        "    return time.time() - t\n",
        "\n",
        "t_cpu = tiempo_una_epoca(\"cpu\")\n",
        "print(f\"CPU ({os.cpu_count()} núcleos): {t_cpu:.1f} s por época\")\n",
        "if DISPOSITIVO == \"cuda\":\n",
        "    tiempo_una_epoca(\"cuda\")                 # la primera vez la GPU \"calienta\"\n",
        "    t_gpu = tiempo_una_epoca(\"cuda\")\n",
        "    print(f\"GPU ({torch.cuda.get_device_name(0)}): {t_gpu:.2f} s por época  →  {t_cpu / t_gpu:.0f} veces más rápida\")"
      ]
    },
    {
