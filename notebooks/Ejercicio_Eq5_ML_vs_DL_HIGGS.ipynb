    "def exp_ensemble():\n",
    "    n = 1_000_000\n",
    "    if n > len(X_pool):\n",
    "        n = len(X_pool)\n",
    "        logger.warning(\n",
    "            f'Reduciendo el tamaño a {n} porque no hay suficientes datos en el pool rápido.')\n",
    "\n",
    "    Xn, yn = X_pool[:n], y_pool[:n]\n",
    "    logger.info(f'\\n========== COMBINACIÓN DE MODELOS (TAMAÑO: {n}) ==========')\n",
    "\n",
    "    # 1. Gradient Boosting\n",
    "    gb = HistGradientBoostingClassifier(max_iter=500, random_state=42)\n",
    "    gb.fit(Xn, yn)\n",
    "    # Guardar las probabilidades de la clase positiva (columna 1)\n",
    "    probs_gb = gb.predict_proba(X_test)[:, 1]\n",
    "    acc_gb = accuracy_score(y_test, probs_gb > 0.5)\n",
    "    logger.info(f'Exactitud Gradient Boosting: {acc_gb * 100:.2f}%')\n",
    "\n",
    "    # 2. Red Neuronal (Base del profesor)\n",
    "    red, _ = entrenar_red(Xn, yn, semilla=42)\n",
    "    probs_red = prob_red(red, X_test)\n",
    "    acc_red = accuracy_score(y_test, probs_red > 0.5)\n",
    "    logger.info(f'Exactitud Red Neuronal: {acc_red * 100:.2f}%')\n",
    "\n",
    "    # 3. EL COMBO (Promedio Simple)\n",
    "    probs_ensemble = (probs_gb + probs_red) / 2.0\n",
    "    acc_ensemble = accuracy_score(y_test, probs_ensemble > 0.5)\n",
    "    logger.info(f'>> EXACTITUD ENSEMBLE (COMBO): {acc_ensemble * 100:.2f}%')\n",
    "\n",
    "    if acc_ensemble > acc_gb and acc_ensemble > acc_red:\n",
    "        logger.info('¡Éxito! El ensemble logró vencer a ambos modelos por separado.')\n",
    "\n",
    "\n",
    "exp_ensemble()"
   ],
